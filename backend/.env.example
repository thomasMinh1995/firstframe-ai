AI_PROVIDER=auto
OPENAI_API_KEY=
MODEL=gpt-5.5
TEMPERATURE=0.3

# Used when OPENAI_API_KEY is empty, or AI_PROVIDER=ollama.
# Install the model first: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_LENGTH=16384

# Optional absolute directory for automatic local dataset recordings.
# Defaults to backend/.data/datasets (ignored by Git).
DATASET_DIR=

# Optional: read JSON/JSONL demo files only from this export directory.
# Imported reviewed packages are always available from DATASET_DIR/reviews.sqlite3.
# Empty loads DATASET_DIR plus the bundled recorded demo.
DEMO_DATASET_DIR=

# Optional local sketches. Setup image-runtime and image-models under backend/.data
# first; generation is offline, fixed 768x432/9 steps/seed 42, max 180 seconds.
# Leave empty to keep manual/text work available without an image provider.
SCENE_IMAGE_PROVIDER=
