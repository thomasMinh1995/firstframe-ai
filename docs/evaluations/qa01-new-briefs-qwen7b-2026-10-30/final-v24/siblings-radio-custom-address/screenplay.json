    "source": {
      "id": "6a2a88f9-3e4a-4aeb-94d4-dd4e24a91ffa",
      "project_revision": 1,
      "version_id": "current",
      "draft": {
        "title": "Máy radio chưa sửa",
        "logline": "Chị Hạnh đặt máy radio hỏng lên bàn. Em trai Nam lấy tua vít rồi ngồi xuống cạnh bàn. Hạnh và Nam nhìn chiếc radio vẫn im tiếng.",
        "sections": [
          {
            "title": "Story",
            "purpose": "Author brief",
            "content": "Chị Hạnh đặt máy radio hỏng lên bàn. Em trai Nam lấy tua vít rồi ngồi xuống cạnh bàn. Hạnh và Nam nhìn chiếc radio vẫn im tiếng."
          }
        ]
      },
      "context": {
        "idea": "Chị Hạnh đặt máy radio hỏng lên bàn. Em trai Nam lấy tua vít rồi ngồi xuống cạnh bàn. Hạnh và Nam nhìn chiếc radio vẫn im tiếng.",
        "constraints": [
          "Đúng ba cảnh, chỉ Hạnh và Nam; máy radio chưa hoạt động ở cuối.",
          "Mỗi cảnh có đúng hai câu thoại, Hạnh trước rồi Nam. Hạnh xưng chị và gọi Nam là em; Nam xưng em và gọi Hạnh là chị. Không tự sửa xong radio, không lặp ngồi xuống."
        ],
        "clarifications": [],
        "pending_questions": []
      },
