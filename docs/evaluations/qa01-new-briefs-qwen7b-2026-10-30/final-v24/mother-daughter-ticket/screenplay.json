      "heading": "Bếp",
      "blocks": [
        {
          "kind": "action",
          "text": "Mẹ đặt vé tàu lên bàn bếp.",
          "speaker": "",
          "id": "c81f5ca7-93c9-4287-8ca0-8ccde267e358"
        },
        {
          "kind": "dialogue",
          "text": "Con đã nhận vé chưa?",
          "speaker": "Mẹ",
          "id": "c141dd16-7a44-480c-a598-dc292477d1ad"
        },
        {
          "kind": "dialogue",
          "text": "Con đã cất vào túi áo rồi, mẹ.",
          "speaker": "Con gái",
          "id": "36f6ebda-5ee2-40af-abea-1437755394a3"
        }
      ]
    },
    {
      "id": "c2d7efe0-6002-45ea-9860-8eada1818614",
      "source_scene_id": "18db7718-0aff-4140-8cc4-8c32e80342a7",
      "heading": "Túi áo",
      "blocks": [
        {
          "kind": "action",
          "text": "Con gái nhận vé rồi cất vào túi áo.",
          "speaker": "",
          "id": "388b8f3a-b471-4aea-be60-abb0a61316d5"
        },
        {
          "kind": "dialogue",
          "text": "Con đã cất vé vào túi áo chưa?",
          "speaker": "Mẹ",
          "id": "598e5876-0291-440b-b3a2-5f12ca0be171"
        },
        {
          "kind": "dialogue",
          "text": "Con đã cất vào túi áo rồi, mẹ.",
          "speaker": "Con gái",
          "id": "b6a8711f-c7c5-4a53-b2bd-86f07f397bb3"
        }
      ]
    },
    {
      "id": "a7cd7485-76b6-4950-9440-9af63ae5678c",
      "source_scene_id": "010e1f40-be96-4857-ab85-e2898b9dd370",
      "heading": "Cửa nhà",
      "blocks": [
        {
          "kind": "action",
          "text": "Mẹ và con gái đứng ở cửa, con gái vẫn chưa quyết định có lên tàu hay không.",
          "speaker": "",
          "id": "0affb718-7e6d-4900-b600-e7c519eab020"
        },
        {
          "kind": "dialogue",
          "text": "Con có chắc không muốn lên tàu ngay bây giờ không, con?",
          "speaker": "Mẹ",
          "id": "21df1e32-8d49-40f9-98c4-561cf55d8492"
        },
        {
          "kind": "dialogue",
          "text": "Con còn muốn suy nghĩ một chút, mẹ.",
          "speaker": "Con gái",
          "id": "911acd8e-70ac-4cd6-9aee-96f73af4fc9c"
        }
      ]
    }
  ],
