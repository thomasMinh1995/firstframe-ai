        "heading": "Đặt hộp",
        "blocks": [
          {
            "kind": "action",
            "text": "Bố đặt chiếc hộp đóng kín lên bàn.",
            "speaker": "",
            "id": "d204df5e-269c-4f47-afda-d63c1430331f"
          },
          {
            "kind": "dialogue",
            "text": "Đặt hộp lên bàn, con có thấy gì không?",
            "speaker": "Bố",
            "id": "84299e11-4103-49a4-91fa-63fcc1614957"
          },
          {
            "kind": "dialogue",
            "text": "Bố ơi, con không biết.",
            "speaker": "Minh",
            "id": "b6829a6a-bd93-41f1-b6b8-e083f850c9a3"
          }
        ]
      },
      {
        "id": "275ecae3-c6a5-4eed-9918-72387a32178c",
        "source_scene_id": "744a5ae4-138b-454e-82ac-3df2bc8f052d",
        "heading": "Kéo ghế",
        "blocks": [
          {
            "kind": "action",
            "text": "Con trai Minh kéo ghế rồi ngồi xuống.",
            "speaker": "",
            "id": "cb577b9a-5773-4755-942c-f8d77f5590a3"
          },
          {
            "kind": "dialogue",
            "text": "Con trai, ngồi xuống đi.",
            "speaker": "Bố",
            "id": "d316e75a-5c1e-4f46-b9e3-9adde4526237"
          },
          {
            "kind": "dialogue",
            "text": "Bố, con sẽ ngồi đây.",
            "speaker": "Minh",
            "id": "0aac4da6-1f50-423d-96de-6656e2a51cd0"
          }
        ]
      },
      {
        "id": "79ec1b9c-b26f-4408-944f-2973f8fc606e",
        "source_scene_id": "8d1caf00-c9f0-459b-9e94-5b541b2c0355",
        "heading": "Đẩy hộp",
        "blocks": [
          {
            "kind": "action",
            "text": "Bố đẩy chiếc hộp về phía Minh.",
            "speaker": "",
            "id": "2637efc4-535c-474e-a9c0-7d570049b22f"
          },
          {
            "kind": "dialogue",
            "text": "Con, hộp này đẩy về phía con, con có muốn mở không?",
            "speaker": "Bố",
            "id": "80c34937-5044-476d-99d6-e643543d3813"
          },
          {
            "kind": "dialogue",
            "text": "Bố ơi, con chưa biết mở như thế nào.",
            "speaker": "Minh",
            "id": "b7c53ca5-54b0-4adc-a831-6ecebe731075"
          }
        ]
      },
