  "screenplay": {
    "id": "89bd2bfe-0dd5-4ae5-bbba-582c0d235e2c",
    "version": 1,
    "scenes": [
      {
        "id": "42e34759-54de-4207-af54-283ac45e1a6d",
        "source_scene_id": "db594006-295a-4fec-a75d-192f2b53760b",
        "heading": "Chiều mưa",
        "blocks": [
          {
            "kind": "action",
            "text": "Mưa rơi nhẹ ngoài cửa sổ, ánh sáng mờ nhạt từ bên ngoài chiếu vào căn bếp nhỏ, làm ấm không gian. Con gái ngồi ở bàn học, chuẩn bị đi học xa. Cha đứng bên cạnh, đặt chìa khóa lên bàn, sau đó lùi về phía sau, nhìn con gái.",
            "speaker": "",
            "id": "913c4adf-3737-4fb8-920a-0d717ce5e988"
          },
          {
            "kind": "action",
            "text": "Cha đặt một lá thư xin lỗi cạnh chìa khóa, rồi lùi về phía sau, nhìn con gái một cách đầy tình cảm.",
            "speaker": "",
            "id": "d1ce95b8-9bfa-4dd9-9a3e-7b3e393520bc"
          },
          {
            "kind": "action",
            "text": "Con gái nhìn chìa khóa và lá thư, nhưng chưa mở thư. Cô ngồi xuống, uống một ngụm trà.",
            "speaker": "",
            "id": "88b6f97f-34d8-4918-839d-d0e6beaab671"
          },
          {
            "kind": "action",
            "text": "Cha đứng im lặng, nhìn con gái uống trà. Cả hai ngồi im lặng trong căn bếp, ánh sáng từ cửa sổ làm ấm căn phòng.",
            "speaker": "",
            "id": "8e84d9ee-012a-415e-8f05-bac9f727f897"
          }
        ]
      },
      {
        "id": "c1b1ae83-41da-45c4-bd86-72faf5222d42",
        "source_scene_id": "684806e2-68c1-467d-9981-612b514755e1",
        "heading": "Chiều mưa trong căn bếp nhỏ",
        "blocks": [
          {
            "kind": "action",
            "text": "Con gái ngồi xuống, uống một ngụm trà. Cha đứng im lặng, nhìn con gái.",
            "speaker": "",
            "id": "80026378-0ba8-48b9-9f8f-5787ae77f630"
          },
          {
            "kind": "action",
            "text": "Ánh sáng từ cửa sổ làm ấm căn bếp, tạo nên không khí yên lặng giữa hai người.",
            "speaker": "",
            "id": "7744d922-7b18-4e99-a630-c0867b012ca1"
          }
        ]
      }
    ],
    "source_revision": 2,
