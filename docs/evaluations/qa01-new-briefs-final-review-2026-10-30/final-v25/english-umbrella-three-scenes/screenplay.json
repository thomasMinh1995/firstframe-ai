  "scenes": [
    {
      "id": "bee7b354-b853-4326-9c94-a0dbc62aaf39",
      "source_scene_id": "ae6dfc8a-f03b-4c5f-92ee-24f999a4c19e",
      "heading": "SCENE 1",
      "blocks": [
        {
          "kind": "action",
          "text": "Mara puts the folded umbrella on a chair.",
          "speaker": "",
          "id": "ba90e320-7875-41d2-a67c-0c4e4d40d57c"
        },
        {
          "kind": "dialogue",
          "text": "You can take your time.",
          "speaker": "Mara",
          "id": "b4813345-a951-4349-8aa3-43c0a7144a0c"
        },
        {
          "kind": "dialogue",
          "text": "I'm still thinking about it.",
          "speaker": "Owen",
          "id": "c768e88b-3308-4eb3-a0e7-a8318e58a6f0"
        }
      ]
    },
    {
      "id": "f0e77f28-10eb-4ac9-b0fe-8afbe210b730",
      "source_scene_id": "cf9e104c-dfd3-499b-a276-8451130a3fe3",
      "heading": "SCENE 2",
      "blocks": [
        {
          "kind": "action",
          "text": "Owen takes the umbrella from the chair and holds it.",
          "speaker": "",
          "id": "01b83492-0eaf-4c44-bd2e-a7d876cfbc5f"
        },
        {
          "kind": "dialogue",
          "text": "I want to hear what you think.",
          "speaker": "Mara",
          "id": "c6429de8-25bb-4571-9dc8-fb0e97f940d5"
        },
        {
          "kind": "dialogue",
          "text": "I don't know what to say yet.",
          "speaker": "Owen",
          "id": "e83f233b-91c8-4e9a-b8d5-82c4a55bb541"
        }
      ]
    },
    {
      "id": "0848f8d6-db2f-4bfa-bdfb-e0f3018ef9cf",
      "source_scene_id": "91d6fbf5-3918-4451-8283-0e408a5b79c9",
      "heading": "SCENE 3",
      "blocks": [
        {
          "kind": "action",
          "text": "Mara and Owen stand by the closed door, still unsure whether to leave.",
          "speaker": "",
          "id": "9cd19105-8ecf-412f-814c-16375540e0ad"
        },
        {
          "kind": "dialogue",
          "text": "I'm not sure where to start.",
          "speaker": "Mara",
          "id": "5b729abc-92c2-458e-beef-5f6ea23272a8"
        },
        {
          "kind": "dialogue",
          "text": "I'd like to think it through.",
          "speaker": "Owen",
          "id": "07b5137e-53ef-4678-bb27-85b4ce97c04b"
        }
      ]
    }
  ],
