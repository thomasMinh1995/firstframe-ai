  "scenes": [
    {
      "id": "27910a98-7bbc-46f2-8d53-1909d30445b0",
      "source_scene_id": "557de076-8060-419f-a8f0-ed64faea806a",
      "heading": "Bếp",
      "blocks": [
        {
          "kind": "action",
          "text": "Mẹ đặt vé tàu lên bàn bếp.",
          "speaker": "",
          "id": "339c5e28-502d-4c42-a230-3dc354eb699e"
        },
        {
          "kind": "dialogue",
          "text": "Con cứ nghĩ thêm một chút.",
          "speaker": "Mẹ",
          "id": "4406a2e0-069e-4f21-bcc3-169877d267ca"
        },
        {
          "kind": "dialogue",
          "text": "Con vẫn đang nghĩ, mẹ.",
          "speaker": "Con gái",
          "id": "653f6336-348d-4fef-8d95-70ec5b2148e4"
        }
      ]
    },
    {
      "id": "89a0c8cc-9c82-4ef4-b18e-b51933b1abe5",
      "source_scene_id": "6d596ba4-b6c2-4b79-a65b-5e3a5a2099ef",
      "heading": "Túi áo",
      "blocks": [
        {
          "kind": "action",
          "text": "Con gái nhận vé rồi cất vào túi áo.",
          "speaker": "",
          "id": "388ad92a-b88f-433c-9068-132fac72215a"
        },
        {
          "kind": "dialogue",
          "text": "Mẹ không muốn giục con.",
          "speaker": "Mẹ",
          "id": "7e7b1533-fc79-43bd-8501-cdf0c871e81b"
        },
        {
          "kind": "dialogue",
          "text": "Con cần thêm một chút thời gian, mẹ.",
          "speaker": "Con gái",
          "id": "034c9140-fb2e-4261-8a35-20124866a86c"
        }
      ]
    },
    {
      "id": "04075d70-1522-4f9c-a21d-794b3895eb62",
      "source_scene_id": "64bd240c-457c-478d-b817-2c3b9b7f6e98",
      "heading": "Cửa nhà",
      "blocks": [
        {
          "kind": "action",
          "text": "Mẹ và con gái đứng ở cửa, con gái vẫn chưa quyết định có lên tàu hay không.",
          "speaker": "",
          "id": "3f13c7f4-1296-4345-85b6-5ddd7599097a"
        },
        {
          "kind": "dialogue",
          "text": "Mẹ muốn nghe con nói.",
          "speaker": "Mẹ",
          "id": "838ce17e-e6a8-4853-9bbf-9240bb253861"
        },
        {
          "kind": "dialogue",
          "text": "Con muốn nghĩ kỹ hơn, mẹ.",
          "speaker": "Con gái",
          "id": "df1125df-2aee-4573-af8a-2552107bbd48"
        }
      ]
    }
  ],
