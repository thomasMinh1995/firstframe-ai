      "heading": "Đặt hộp",
      "blocks": [
        {
          "kind": "action",
          "text": "Bố đặt chiếc hộp đóng kín lên bàn.",
          "speaker": "",
          "id": "18c1e476-6ccb-49e1-bf55-e84a9b20e5ca"
        },
        {
          "kind": "dialogue",
          "text": "Con, bố nghe đây.",
          "speaker": "Bố",
          "id": "16be44a8-f0d9-4772-87f0-2ff7bd2d2bd3"
        },
        {
          "kind": "dialogue",
          "text": "Con cần thêm một chút thời gian, bố.",
          "speaker": "Minh",
          "id": "cb84308c-105f-4335-8f19-29e6e6f123ea"
        }
      ]
    },
    {
      "id": "e7fd3e1c-7c2f-4c0b-910f-c9f97906dd22",
