      "heading": "Kéo ghế",
      "blocks": [
        {
          "kind": "action",
          "text": "Con trai Minh kéo ghế rồi ngồi xuống.",
          "speaker": "",
          "id": "e5a9b65b-d13d-41d6-8453-3931671dffff"
        },
        {
          "kind": "dialogue",
          "text": "Bố không muốn giục con.",
          "speaker": "Bố",
          "id": "d4ff273d-088b-4978-8d70-67ce5d150828"
        },
        {
          "kind": "dialogue",
          "text": "Con vẫn đang nghĩ, bố.",
          "speaker": "Minh",
          "id": "a0f9b036-dbc6-4482-9110-d1a1f805d4e1"
        }
      ]
    },
    {
