    "source": {
      "id": "2f89f78f-5cdf-4937-85d9-d730d5cd1f67",
      "project_revision": 1,
      "version_id": "current",
      "draft": {
        "title": "Chậu cây ở bậu cửa",
        "logline": "An đặt chậu cây khô lên bàn. Bình đặt bình nước cạnh chậu cây. An cầm bình nước. An nghiêng bình, một ít nước rơi vào đất. An đặt bình rỗng xuống bàn. An và Bình đứng nhìn chậu cây vẫn chưa có lá mới.",
        "sections": [
          {
            "title": "Story",
            "purpose": "Author brief",
            "content": "An đặt chậu cây khô lên bàn. Bình đặt bình nước cạnh chậu cây. An cầm bình nước. An nghiêng bình, một ít nước rơi vào đất. An đặt bình rỗng xuống bàn. An và Bình đứng nhìn chậu cây vẫn chưa có lá mới."
          }
        ]
      },
      "context": {
        "idea": "An đặt chậu cây khô lên bàn. Bình đặt bình nước cạnh chậu cây. An cầm bình nước. An nghiêng bình, một ít nước rơi vào đất. An đặt bình rỗng xuống bàn. An và Bình đứng nhìn chậu cây vẫn chưa có lá mới.",
        "constraints": [
          "Đúng sáu cảnh; chỉ An và Bình trong một căn phòng. Hoàn toàn không thoại, không thuyết minh.",
          "Không lặp việc tưới hoặc biến cây khô thành cây xanh ngay. Bình không tự tưới thay An."
        ],
        "clarifications": [],
        "pending_questions": []
      },
