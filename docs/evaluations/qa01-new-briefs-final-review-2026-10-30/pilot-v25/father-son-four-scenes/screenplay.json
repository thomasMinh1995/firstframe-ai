      "heading": "Đặt hộp",
      "blocks": [
        {
          "kind": "action",
          "text": "Bố đặt chiếc hộp đóng kín lên bàn.",
          "speaker": "",
          "id": "4989cd67-08fe-46be-a4dc-12e58ce3ed2e"
        },
        {
          "kind": "dialogue",
          "text": "Bố không muốn giục con.",
          "speaker": "Bố",
          "id": "af9b2aa2-8ecc-4005-96ef-5bd8ddb94d22"
        },
        {
          "kind": "dialogue",
          "text": "Con cần thêm một chút thời gian, bố.",
          "speaker": "Minh",
          "id": "491a5a6b-303f-4994-a29a-8fa03f4fbe44"
        }
      ]
    },
    {
      "id": "b29de604-b8d4-4185-a28e-e4ea434da5c4",
      "source_scene_id": "367a6cb0-aceb-4ce6-a284-56a0523e6e89",
      "heading": "Kéo ghế",
      "blocks": [
        {
          "kind": "action",
          "text": "Con trai Minh kéo ghế rồi ngồi xuống.",
          "speaker": "",
          "id": "26555aa0-90af-4214-8f71-d1920c8e8f33"
        },
        {
          "kind": "dialogue",
          "text": "Con, bố nghe đây.",
          "speaker": "Bố",
          "id": "c6b733c7-3833-41ba-a9ae-39e58a648bdb"
        },
        {
          "kind": "dialogue",
          "text": "Con vẫn đang nghĩ, bố.",
          "speaker": "Minh",
          "id": "284bf8c1-2a54-4a45-b844-ce366d107040"
        }
      ]
    },
    {
      "id": "62c822d7-b2e4-4589-9c0e-b45c1d52e850",
      "source_scene_id": "a268a39c-510f-4e7d-a51d-950a0234c2a0",
      "heading": "Đẩy hộp",
      "blocks": [
        {
          "kind": "action",
          "text": "Bố đẩy chiếc hộp về phía Minh.",
          "speaker": "",
          "id": "32ba4368-a960-4dd4-8405-fd1d894609c4"
        },
        {
          "kind": "dialogue",
          "text": "Con cứ nghĩ thêm một chút.",
          "speaker": "Bố",
          "id": "6218209a-13f7-4246-819e-5154d7728e14"
        },
        {
          "kind": "dialogue",
          "text": "Con muốn nghĩ kỹ hơn, bố.",
          "speaker": "Minh",
          "id": "156fd360-ef94-4ddb-afbb-2c0947191034"
        }
      ]
    },
    {
      "id": "0fd2d304-5c52-4baa-82f0-6cbb59701eac",
      "source_scene_id": "ce134dda-a06b-4c21-a62f-c0fb2d1f51fd",
      "heading": "Tay trên nắp",
      "blocks": [
        {
          "kind": "action",
          "text": "Minh đặt tay lên nắp hộp nhưng chưa mở, bố vẫn đứng cạnh bàn.",
          "speaker": "",
          "id": "c07741ab-8a80-4d66-ba0c-3040b54e7b28"
        },
        {
          "kind": "dialogue",
          "text": "Bố chưa biết bắt đầu thế nào.",
          "speaker": "Bố",
          "id": "12531e3b-0b34-4fa8-984e-80bb5fd6492a"
        },
        {
          "kind": "dialogue",
          "text": "Con chưa có câu trả lời, bố.",
          "speaker": "Minh",
          "id": "8a363f56-d5a5-40d6-a05c-3384f7b5698e"
        }
      ]
    }
