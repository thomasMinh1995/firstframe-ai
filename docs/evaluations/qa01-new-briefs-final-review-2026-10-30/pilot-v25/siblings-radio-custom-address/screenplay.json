{
  "id": "477b21c8-73d2-4322-9890-b25d4819c904",
  "version": 1,
  "scenes": [
    {
      "id": "afb72e47-6140-4f22-a266-5b9c60f6c809",
      "source_scene_id": "b8e499ed-c9f3-4520-80fe-262ac1b7578c",
      "heading": "Radio hỏng",
      "blocks": [
        {
          "kind": "action",
          "text": "Chị Hạnh đặt máy radio hỏng lên bàn.",
          "speaker": "",
          "id": "33885226-46cd-4175-abf2-e631f132608e"
        },
        {
          "kind": "dialogue",
          "text": "Em cứ nghĩ thêm một chút.",
          "speaker": "Hạnh",
          "id": "6672422e-5dfb-48ab-bf7b-ec970080f744"
        },
        {
          "kind": "dialogue",
          "text": "Em cần thêm một chút thời gian, chị.",
          "speaker": "Nam",
          "id": "55bb28f1-97ad-4c1d-9ab9-f8a0c881f05c"
        }
      ]
    },
    {
      "id": "73f73785-b18a-4796-b430-669ed6a9ced3",
      "source_scene_id": "720598c2-6576-4d12-9114-3e900f6f9735",
      "heading": "Tua vít",
      "blocks": [
        {
          "kind": "action",
          "text": "Em trai Nam lấy tua vít rồi ngồi xuống cạnh bàn.",
          "speaker": "",
          "id": "8e714e04-447a-499b-a4fb-75113ab9bcf2"
        },
        {
          "kind": "dialogue",
          "text": "Chị không muốn giục em.",
          "speaker": "Hạnh",
          "id": "da4f260f-38b7-4be2-85fa-0650d7c0d2f7"
        },
        {
          "kind": "dialogue",
          "text": "Em vẫn đang nghĩ, chị.",
          "speaker": "Nam",
          "id": "2ef37e02-5d59-4773-84ef-75496661e76d"
        }
      ]
    },
    {
      "id": "a267ff46-9be9-40b7-9d7b-0d9f726d3c89",
      "source_scene_id": "3e6e410f-3c8b-4b3c-834f-762579a82e88",
      "heading": "Chờ tiếng nhạc",
      "blocks": [
        {
          "kind": "action",
          "text": "Hạnh và Nam nhìn chiếc radio vẫn im tiếng.",
          "speaker": "",
          "id": "74a7f79e-6e56-4246-aaea-4b3a4677bf8b"
        },
        {
          "kind": "dialogue",
          "text": "Em, chị nghe đây.",
          "speaker": "Hạnh",
          "id": "b4d6fb36-b6fd-4512-a308-62ac4e58b120"
        },
        {
          "kind": "dialogue",
          "text": "Em chưa biết trả lời thế nào, chị.",
          "speaker": "Nam",
          "id": "dbf2786c-0005-44f2-b6e0-30718b652d4f"
        }
      ]
    }
  ],
