        "heading": "CẢNH 1",
        "blocks": [
          {
            "kind": "action",
            "text": "Mẹ đặt vé tàu lên bàn bếp.",
            "speaker": "",
            "id": "6afb1d11-b70e-4c70-bad9-6cd895c33518"
          },
          {
            "kind": "dialogue",
            "text": "Mẹ không muốn giục con.",
            "speaker": "Mẹ",
            "id": "040b0de7-c738-40a7-bce7-5e67afab22ac"
          },
          {
            "kind": "dialogue",
            "text": "Con vẫn đang nghĩ, mẹ.",
            "speaker": "Con gái",
            "id": "98e3a555-cf2a-49cc-8e3e-5a16026ccc8d"
          }
        ]
      },
      {
        "id": "bb9fac4c-a994-428a-b7db-6990cf6c2ce3",
        "source_scene_id": "60a397b7-466c-499b-a131-e4ec69579fdd",
        "heading": "CẢNH 2",
        "blocks": [
          {
            "kind": "action",
            "text": "Con gái nhận vé rồi cất vào túi áo.",
            "speaker": "",
            "id": "2b66f6f1-bcd7-4a7f-a4e3-8429e9e9a47a"
          },
          {
            "kind": "dialogue",
            "text": "Con cứ nghĩ thêm một chút.",
            "speaker": "Mẹ",
            "id": "06f10567-01c9-434f-bc60-1ba094b795fa"
          },
          {
            "kind": "dialogue",
            "text": "Con cần thêm một chút thời gian, mẹ.",
            "speaker": "Con gái",
            "id": "06baf300-8570-47f0-87d8-f65b2c8bcdf1"
          }
        ]
      },
      {
        "id": "d54066f9-ef69-4951-9798-40a46b7e5f15",
        "source_scene_id": "9a2f16bd-4de5-4fa9-9df2-1abb2dc1e298",
        "heading": "CẢNH 3",
        "blocks": [
          {
            "kind": "action",
            "text": "Mẹ và con gái đứng ở cửa, con gái vẫn chưa quyết định có lên tàu hay không.",
            "speaker": "",
            "id": "90830c0f-365e-41f4-90ad-cae25602d269"
          },
          {
            "kind": "dialogue",
            "text": "Mẹ muốn nghe con nói.",
            "speaker": "Mẹ",
            "id": "b1de60aa-e945-4616-bc12-977b3976e277"
          },
          {
            "kind": "dialogue",
            "text": "Con muốn nghĩ kỹ hơn, mẹ.",
            "speaker": "Con gái",
            "id": "2525f431-532b-47fe-9277-594120479b64"
          }
        ]
      }
    ],
    "source_revision": 2,
