        "draft": {
          "title": "Đặt vé tàu",
          "logline": "Mẹ đặt vé tàu lên bàn bếp, con gái nhận và cân nhắc việc lên tàu, cuối cùng quyết định không đi.",
          "sections": [
            {
              "title": "Core idea",
              "purpose": "State the short film's central promise.",
              "content": "Mẹ đặt vé tàu lên bàn bếp, con gái nhận và cân nhắc việc lên tàu, cuối cùng quyết định không đi."
            },
            {
              "title": "Main character",
              "purpose": "Define the protagonist and key character pressure.",
              "content": "Con gái Mẹ"
            },
            {
              "title": "Main conflict",
              "purpose": "Describe the obstacle and stakes.",
              "content": "Vé tàu và quyết định của con gái Cân nhắc giữa việc đi hay không đi Cảm giác tự lập và quyết định của bản thân"
            },
            {
              "title": "Beginning",
              "purpose": "Set up the story world and first dramatic turn.",
              "content": "Mẹ đặt vé tàu lên bàn bếp, con gái nhận và cất vào túi áo."
            },
            {
              "title": "Middle",
              "purpose": "Escalate pressure and reveal the emotional turn.",
              "content": "Con gái đứng ở cửa, cân nhắc việc lên tàu, cuối cùng quyết định không đi."
            },
            {
              "title": "Ending",
              "purpose": "Resolve the short film through a visible choice or image.",
              "content": "Con gái quyết định không đi tàu, mẹ và con gái đứng ở cửa, con gái quay lại nhìn mẹ. Con gái quay lại nhìn mẹ, mẹ nhìn con gái với ánh mắt đầy ý nghĩa."
            },
            {
              "title": "Theme",
              "purpose": "Name the human idea underneath the plot.",
              "content": "Cảm giác tự lập và quyết định của bản thân."
            },
            {
              "title": "Visual Style",
              "purpose": "Capture the visual approach and recurring motifs.",
              "content": "Tone nhẹ nhàng, sử dụng màu sắc ấm áp và hình ảnh tự nhiên. Bàn bếp, Vé tàu"
            },
            {
              "title": "Tone",
              "purpose": "Describe the intended emotional register.",
              "content": "Nhiệt tình và nhẹ nhàng, tập trung vào cảm xúc của nhân vật."
            },
            {
              "title": "Production Notes",
              "purpose": "Keep the idea grounded for short-film production.",
              "content": "Cảnh quay đơn giản, chỉ có mẹ và con gái. Sử dụng ánh sáng tự nhiên để tạo cảm giác ấm áp. Sử dụng âm thanh nhẹ nhàng để tăng cường cảm xúc. Bếp 2 người"
            }
          ]
        },
        "context": {
          "idea": "Mẹ đặt vé tàu lên bàn bếp. Con gái nhận vé rồi cất vào túi áo. Mẹ và con gái đứng ở cửa, con gái vẫn chưa quyết định có lên tàu hay không.",
          "constraints": [
            "Đúng ba cảnh, chỉ mẹ và con gái; giữ kết mở.",
            "Mỗi cảnh có đúng hai câu thoại ngắn: mẹ nói một câu, con gái đáp một câu. Mẹ xưng mẹ, con gái xưng con; không dùng tôi/bạn. Không lặp việc trao vé hoặc tự xác nhận con lên tàu."
          ],
          "clarifications": [],
          "pending_questions": [
            {
              "question": "Con gái có quyết định lên tàu không?",
              "input_index": 0
            }
          ]
        },
